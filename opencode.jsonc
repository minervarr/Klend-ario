{
  "$schema": "https://opencode.ai/config.json",
  // The agent manual lives in essentialAgent/. Read its README.md first.
  // These files load every session so the rules and decisions always apply.
  "instructions": [
    "essentialAgent/AGENTS.md",
    "essentialAgent/MEMORY.md",
    "essentialAgent/REQUIREMENTS.md",
    "essentialAgent/TESTING.md",
  ],
  // Reusable workflows (essentialAgent/skills/klend-ario/SKILL.md).
  "skills": ["./essentialAgent/skills"],
  // The app's own MCP server: the AI-facing calendar surface (mcp/README.md).
  // All tiers default on; append "--permissions", "read" to restrict an agent.
  "mcp": {
    "klend_ario": {
      "type": "local",
      "command": ["./build/mcp/klend_ario_mcp_server"],
      "timeout": 10000,
      "enabled": true,
    },
  },
}
